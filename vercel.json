{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.py": {
      "maxDuration": 300
    }
  },
  "rewrites": [
    {
      "source": "/api/:route(login|logout|me|learner|tutor|next_concept|define|export_md|export_html|digest)",
      "destination": "/api/index"
    }
  ]
}
